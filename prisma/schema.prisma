  Claude_3_Sonnet
  Claude_3_Haiku
  Gemini_1_5_Pro
  Gemini_1_5_Flash
  Gemini_1_0_Pro
  DALL_E
  Llama_3_2_90b_Vision
  Claude_3_5_Haiku
  Grok_beta
  GPT_o1_preview
  GPT_o1_mini
  Gemini_2_0_Flash
  Gemini_2_0_Flash_Lite
  Grok_2
  Grok_2_vision
  GPT_o1
  GPT_o3_mini
  Claude_3_7_Sonnet
  R1
